VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key-here

# URL Sistem Ujian Eksternal CBT SDI SAIQ AL-HIKMAH (Pertahankan sistem yang sudah ada)
VITE_EXTERNAL_EXAM_URL=https://cbt.sdisaiqalhikmah.sch.id
